    "keywords": ["custom", "command", "project", "plugin"],
    "chainRole": "subject",
    "chainTemplate": ".{{commandName}}([[args:{{args}}]])",
    "codeTemplate": "cy.{{commandName}}([[args:{{args}}]]);"
  }
]
