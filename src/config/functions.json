[
  {
    "type": "visit",
    "label": "Visit",
    "category": "command",
    "group": "browser",
    "subgroup": "navigation",
    "description": "Navigate the browser to a URL.",
    "keywords": ["url", "navigate", "goto", "open", "page"],
    "codeTemplate": "cy.visit('{{url}}');"
  },

  {
    "type": "get",
    "label": "Get",
    "category": "command",
    "group": "traversal",
    "subgroup": "element",
    "description": "Select elements by CSS selector.",
    "keywords": ["query", "css", "selector", "element", "data-testid"],
    "chainRole": "root",
    "codeTemplate": "cy.get('{{selector}}');"
  },
  {
    "type": "contains",
    "label": "Contains",
    "category": "command",
    "group": "traversal",
    "subgroup": "element",
    "description": "Select the element containing the given text.",
    "keywords": ["text", "label", "search"],
    "chainRole": "root",
    "codeTemplate": "cy[[selector:.get('{{selector}}')]].contains('{{text}}');"
  },
  {
    "type": "find",
    "label": "Find",
    "category": "command",
    "group": "traversal",
    "subgroup": "element",
    "description": "Search for descendants of the current subject.",
    "keywords": ["descendant", "child", "within", "search"],
    "chainRole": "subject",
    "chainTemplate": ".find('{{target}}')",
    "codeTemplate": "cy.get('{{selector}}').find('{{target}}');"
  },
  {
    "type": "first",
    "label": "First",
    "category": "command",
    "group": "traversal",
    "subgroup": "position",
    "description": "Narrow to the first element of the current subject.",
    "keywords": ["index", "position", "head"],
    "chainRole": "subject",
    "chainTemplate": ".first()",
    "codeTemplate": "cy.get('{{selector}}').first();"
  },
  {
    "type": "last",
    "label": "Last",
    "category": "command",
    "group": "traversal",
    "subgroup": "position",
    "description": "Narrow to the last element of the current subject.",
    "keywords": ["index", "position", "tail"],
    "chainRole": "subject",
    "chainTemplate": ".last()",
    "codeTemplate": "cy.get('{{selector}}').last();"
  },
  {
    "type": "eq",
    "label": "Eq",
    "category": "command",
    "group": "traversal",
    "subgroup": "position",
    "description": "Narrow to the element at a zero-based index.",
    "keywords": ["index", "nth", "position", "row"],
    "chainRole": "subject",
    "chainTemplate": ".eq({{index}})",
    "codeTemplate": "cy.get('{{selector}}').eq({{index}});"
  },

  {
    "type": "click",
    "label": "Click",
    "category": "command",
    "group": "action",
    "subgroup": "mouse",
    "description": "Click the current subject.",
    "keywords": ["press", "tap", "button", "mouse"],
    "chainRole": "subject",
