  {
    "type": "intercept",
    "label": "Intercept",
    "category": "command",
    "group": "network",
    "description": "Intercept matching network requests, optionally stubbing the response.",
    "keywords": ["network", "mock", "stub", "spy", "route", "api"],
    "chainRole": "root",
    "codeTemplate": "cy.intercept([[method:'{{method}}', ]]'{{url}}'[[stubResponse:, {{stubResponse}}]]);"
  },
  {
    "type": "waitAlias",
    "label": "Wait for Alias",
    "category": "command",
    "common": true,
    "group": "network",
    "description": "Wait for a previously intercepted (or otherwise aliased) request/response.",
    "keywords": ["network", "wait", "alias", "request", "response"],
    "chainRole": "root",
    "codeTemplate": "cy.wait('{{alias}}');",
    "requiresTriggerBeforeUse": true
  },
  {
    "type": "request",
    "label": "Request",
    "category": "command",
    "group": "network",
    "description": "Make an HTTP request directly, outside the app under test.",
    "keywords": ["network", "api", "http", "fetch"],
    "chainRole": "root",
    "codeTemplate": "cy.request({\n[[method:  method: '{{method}}',\n]]  url: '{{url}}'[[body:,\n  body: {{body}}]]\n});"
  },
  {
    "type": "customCommand",
