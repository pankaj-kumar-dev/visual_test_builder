  {
    "type": "next",
    "label": "Next",
    "category": "command",
    "group": "traversal",
    "subgroup": "relative",
    "description": "Get the immediately following sibling of the current subject.",
    "keywords": ["dom", "adjacent", "sibling"],
    "chainRole": "subject",
    "chainTemplate": ".next([[match:'{{match}}']])"
