  {
    "type": "should",
    "label": "Assert",
    "category": "command",
    "group": "assertion",
    "description": "Assert something about the current subject.",
    "keywords": ["should", "expect", "assertion", "verify", "visible", "text", "length"],
    "chainRole": "subject",
    "chainTemplate": ".should('{{assertion}}'[[value:, '{{value}}']][[count:, {{count}}]])",
    "codeTemplate": "cy.get('{{selector}}').should('{{assertion}}'[[value:, '{{value}}']][[count:, {{count}}]]);"
  }
