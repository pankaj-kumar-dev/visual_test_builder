  {
    "type": "prev",
    "label": "Prev",
    "category": "command",
    "group": "traversal",
    "subgroup": "relative",
    "description": "Get the immediately preceding sibling of the current subject.",
    "keywords": ["dom", "adjacent", "sibling"],
    "chainRole": "subject",
    "chainTemplate": ".prev([[match:'{{match}}']])"
