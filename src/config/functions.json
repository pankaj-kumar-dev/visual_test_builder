  {
    "type": "closest",
    "label": "Closest",
    "category": "command",
    "group": "traversal",
    "subgroup": "relative",
    "description": "Get the closest ancestor matching a selector.",
    "keywords": ["ancestor", "dom", "match"],
    "chainRole": "subject",
    "chainTemplate": ".closest('{{match}}')"
  },
  {
    "type": "filter",
    "label": "Filter",
    "category": "command",
    "group": "traversal",
    "subgroup": "relative",
    "description": "Narrow the current subject to elements matching a selector.",
    "keywords": ["dom", "match", "narrow"],
    "chainRole": "subject",
    "chainTemplate": ".filter('{{match}}')"
  },

