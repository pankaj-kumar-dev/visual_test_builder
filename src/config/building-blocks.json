    "allowedChildren": [],
    "props": [
      { "key": "condition", "label": "Condition", "type": "expression", "required": true }
    ],
    "codeTemplate": "if ({{condition}}) {\n{{slot:then}}\n}[[slot:else: else {\n{{slot:else}}\n}]]"
  },
